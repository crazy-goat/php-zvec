{
    "name": "crazy-goat/zvec",
    "description": "PHP FFI bindings for zvec vector database",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/crazy-goat/php-zvec",
    "support": {
        "issues": "https://github.com/crazy-goat/php-zvec/issues",
        "source": "https://github.com/crazy-goat/php-zvec"
    },
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*"
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\ZVec\\": "src/"
        }
    },
    "bin": [
        "bin/zvec-install"
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "scripts": {
        "lint": "bin/lint.sh",
        "lint:fix": "bin/lint.sh --fix"
    }
}
