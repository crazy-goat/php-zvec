parameters:
    level: 2
    phpVersion:
        min: 80100
        max: 80500
    paths:
        - src
    ignoreErrors:
        # Every libzvec call goes through FFI's magic __call, and C struct fields are
        # read through FFI\CData's magic __get/__set; neither can be described to PHPStan.
        - '#Call to an undefined method FFI::#'
        - '#Access to an undefined property FFI\\CData::#'
